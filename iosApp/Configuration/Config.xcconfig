TEAM_ID=

PRODUCT_NAME=DZ
PRODUCT_BUNDLE_IDENTIFIER=com.example.dz.DZ$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// SQLDelight's native driver (SQLiter) requires the system sqlite3 library;
// the Shared framework is static, so the app binary must link it.
OTHER_LDFLAGS=$(inherited) -lsqlite3